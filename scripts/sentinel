#!/usr/bin/env bash
# ========================================================
# Dev Laptop Sentinel CLI Control Tool
# Manage Sentinel service, tray indicator, and web dashboard
# ========================================================

APP_DIR="/home/nurjaks/Dev/dev-sentinel"
APP_EXEC="$APP_DIR/app.py"
STATE_DIR="$HOME/.local/state/dev-sentinel"
PID_FILE="$STATE_DIR/sentinel.pid"
LOG_FILE="$STATE_DIR/sentinel.log"
PORT=48888

mkdir -p "$STATE_DIR"

get_pid() {
    # Check by listening port first
    local port_pid
    port_pid=$(ss -tlpn "sport = :$PORT" 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 | head -n1)
    if [ -n "$port_pid" ]; then
        echo "$port_pid"
        return 0
    fi

    # Fallback to PID file
    if [ -f "$PID_FILE" ]; then
        local file_pid
        file_pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$file_pid" ] && kill -0 "$file_pid" 2>/dev/null; then
            echo "$file_pid"
            return 0
        fi
    fi
    return 1
}

start_sentinel() {
    local pid
    if pid=$(get_pid); then
        echo -e "\e[1;33m⚠️  Dev Sentinel уже запущен (PID: $pid) на порту $PORT\e[0m"
        echo -e "   Дашборд: \e[1;36mhttp://localhost:$PORT\e[0m"
        return 0
    fi

    echo -e "\e[1;34m🚀 Запуск Dev Sentinel (фон + системный трей)...\e[0m"

    # Ensure display env is passed for Ayatana GNOME tray
    export DISPLAY="${DISPLAY:-:0}"
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
    export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-GNOME}"

    setsid python3 -u "$APP_EXEC" >> "$LOG_FILE" 2>&1 &
    local new_pid=$!
    echo "$new_pid" > "$PID_FILE"

    # Wait for web server to initialize
    local max_wait=5
    local count=0
    local started=false

    while [ $count -lt $max_wait ]; do
        sleep 1
        if curl -s "http://127.0.0.1:$PORT/api/telemetry" >/dev/null 2>&1; then
            started=true
            break
        fi
        count=$((count + 1))
    done

    if [ "$started" = true ]; then
        echo -e "\e[1;32m✅ Dev Sentinel успешно запущен!\e[0m"
        echo -e "   PID: \e[1;37m$new_pid\e[0m"
        echo -e "   Веб-дашборд: \e[1;36mhttp://localhost:$PORT\e[0m"
        echo -e "   Трей: \e[1;32mАктивен в верхней панели GNOME\e[0m"
        echo -e "   Логи: $LOG_FILE"
    else
        echo -e "\e[1;31m❌ Не удалось подтвердить запуск Sentinel за $max_wait сек.\e[0m"
        echo -e "   Проверьте лог: \e[1;37mcat $LOG_FILE\e[0m"
        return 1
    fi
}

stop_sentinel() {
    local pid
    if pid=$(get_pid); then
        echo -e "\e[1;33m🛑 Остановка Dev Sentinel (PID: $pid)...\e[0m"
        kill "$pid" 2>/dev/null || true
        sleep 1
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
        echo -e "\e[1;32m✅ Dev Sentinel остановлен.\e[0m"
    else
        echo -e "\e[1;33mℹ️  Dev Sentinel не был запущен.\e[0m"
        rm -f "$PID_FILE"
    fi
}

status_sentinel() {
    local pid
    if pid=$(get_pid); then
        echo -e "\e[1;32m● Dev Laptop Sentinel: АКТИВЕН (RUNNING)\e[0m"
        echo -e "  PID: \e[1;37m$pid\e[0m"
        echo -e "  Порт: \e[1;36m$PORT\e[0m"
        echo -e "  Дашборд: \e[1;36mhttp://localhost:$PORT\e[0m"

        # Try to pull real-time metrics
        local telemetry
        telemetry=$(curl -s "http://127.0.0.1:$PORT/api/telemetry" 2>/dev/null)
        if [ -n "$telemetry" ]; then
            local temp load ram bat
            temp=$(echo "$telemetry" | jq -r '.cpu.package_temp // "--"')
            load=$(echo "$telemetry" | jq -r '.cpu.load_percent // "--"')
            ram=$(echo "$telemetry" | jq -r '.ram.used_gb // "--"')
            bat=$(echo "$telemetry" | jq -r '.battery.percent // "--"')
            echo -e "  🔥 CPU: \e[1;31m${temp}°C\e[0m (Нагрузка: ${load}%) | 💾 RAM: \e[1;35m${ram} GB\e[0m | 🔋 Батарея: \e[1;32m${bat}%\e[0m"
        fi
    else
        echo -e "\e[1;31m○ Dev Laptop Sentinel: ОСТАНОВЛЕН (STOPPED)\e[0m"
        echo -e "  Для запуска выполните: \e[1;32msentinel start\e[0m"
    fi
}

open_dashboard() {
    if get_pid >/dev/null 2>&1; then
        echo -e "\e[1;34m🌐 Открытие дашборда: http://localhost:$PORT\e[0m"
        xdg-open "http://localhost:$PORT" >/dev/null 2>&1 &
    else
        echo -e "\e[1;33m⚠️  Sentinel не запущен. Запускаю...\e[0m"
        start_sentinel
        xdg-open "http://localhost:$PORT" >/dev/null 2>&1 &
    fi
}

case "$1" in
    start)
        start_sentinel
        ;;
    stop)
        stop_sentinel
        ;;
    restart)
        stop_sentinel
        sleep 1
        start_sentinel
        ;;
    status)
        status_sentinel
        ;;
    open)
        open_dashboard
        ;;
    logs)
        tail -f "$LOG_FILE"
        ;;
    help|--help|-h)
        echo "Dev Laptop Sentinel CLI Management"
        echo ""
        echo "Использование:"
        echo "  sentinel [команда]"
        echo ""
        echo "Команды:"
        echo "  status   (по умолчанию) Показать статус и текущую температуру/память"
        echo "  start    Запустить мониторинг в фоне (веб-сервер + трей)"
        echo "  stop     Остановить мониторинг"
        echo "  restart  Перезапустить"
        echo "  open     Открыть веб-дашборд в браузере"
        echo "  logs     Смотреть логи работы в реальном времени"
        ;;
    *)
        status_sentinel
        ;;
esac
